// FACTURA PRA CUALQUIER TIPO DE IMPRESORA

const imprimirFacturaMixta = async (id, totalToPay, products) => {
  const ivaTipo = 0.21; // IVA al 21% (por defecto)
  const iva = totalToPay * ivaTipo;
  const baseImponible = totalToPay; // El total sin IVA
  
  // Crear el texto de la factura
  const fecha = new Date().toLocaleDateString('es-ES');
  const numeroFactura = generateUniqueId(); // Generar un número de factura único

  const facturaText = `
    FACTURA DE VENTA

    EMISOR:
    Razón Social: Burger-Shop
    NIF: B12345678
    Dirección: Avenida Siempreviva 123, Madrid, España
    Teléfono: 233534
    Email: blablalb@blabla.com

    COMPRADOR:
    Cliente: ${id}
    NIF/NIE: No identificado
    Dirección: null
    Teléfono: null

    DETALLES DE LA FACTURA:
    Fecha: ${fecha}, Número de factura: ${numeroFactura}

    Productos:
    ${products.map((product, index) => `
      ${index + 1}. ${product.name} - ${product.price} €
    `).join('\n')}

    Subtotal (sin IVA): ${baseImponible} €
    IVA (${ivaTipo * 100}%): ${iva} €
    Total a pagar (IVA incluido): ${totalToPay + iva} €
  `;

  try {
    // Intenta imprimir con ESC/POS si es una impresora térmica
    const device = await navigator.usb.requestDevice({
      filters: [{ vendorId: 0x1234 }] // El identificador de la impresora (reemplázalo con el correcto)
    });

    if (device) {
      await device.open();
      await device.selectConfiguration(1);
      await device.claimInterface(0);
      
      // Imprimir usando ESC/POS
      const encoder = new TextEncoder();
      const data = encoder.encode(facturaText);
      await device.transferOut(1, data);
      
      await device.close();
    }
  } catch (error) {
    console.error("No se pudo imprimir con ESC/POS, intentando con PDF/HTML.", error);
    
    // Si no funciona la impresora térmica, usa PDF o HTML
    const htmlContent = `
      <div style="font-family: Arial, sans-serif; padding: 10px;">
        <h2 style="text-align: center;">FACTURA DE VENTA</h2>
        <p><strong>EMISOR:</strong></p>
        <p>Razón Social: Burger-Shop</p>
        <p>NIF: B12345678</p>
        <p>Dirección: Avenida Siempreviva 123, Madrid, España</p>
        <p>Teléfono: 233534</p>
        <p>Email: blablalb@blabla.com</p>
        
        <p><strong>COMPRADOR:</strong></p>
        <p>Cliente: ${id}</p>
        <p>NIF/NIE: No identificado</p>
        <p>Dirección: null</p>
        <p>Teléfono: null</p>

        <p><strong>DETALLES DE LA FACTURA:</strong></p>
        <p>Fecha: ${fecha}, Número de factura: ${numeroFactura}</p>

        <h3>Productos:</h3>
        <ul>
          ${products.map((product, index) => `
            <li>${product.name} - ${product.price} €</li>
          `).join('')}
        </ul>

        <p><strong>Subtotal (sin IVA):</strong> ${baseImponible} €</p>
        <p><strong>IVA (21%):</strong> ${iva} €</p>
        <p><strong>Total a pagar (IVA incluido):</strong> ${totalToPay + iva} €</p>
      </div>
    `;

    // Crear una ventana de impresión para una impresora normal
    const printWindow = window.open('', '', 'height=400,width=600');
    printWindow.document.write(htmlContent);
    printWindow.document.close();
    printWindow.print();
  }
};



  // RETURN PRINCIPAL COMPONENTE
  return (
   securityAdmin ? ( <div className="container-admin">
      <div className="container-logo-macdonalds-admin">
        <img src={mcDonaldsLogo} className="img-logo-macdonalds-admin" />
        <h1>Administrador</h1>



        <nav className="barnav-admin">
          <button id="btn-number" style={{ display: "flex", flexDirection: "row" }} onClick={() => functionVisibilityHome()}>INICIO <p style={{
        marginLeft: '5px',
        backgroundColor: 'red',
        color: 'white',
        borderRadius: '50%',
        padding: '2px 8px',
        fontSize: '12px',
        fontWeight: 'bold',
        display: 'inline-flex',
        alignItems: 'center',
        justifyContent: 'center',
        minWidth: '20px',
        minHeight: '20px',
        textAlign: 'center',
        lineHeight: '1'
      }}>
        {newOrderInProcess}
      </p></button>
          <button disabled={freeVersion} id="btn-number" style={{ display: "flex", flexDirection: "row" }} onClick={() => functionVisibilityTables()}>MESAS <p style={{
        marginLeft: '5px',
        backgroundColor: 'red',
        color: 'white',
        borderRadius: '50%',
        padding: '2px 8px',
        fontSize: '12px',
        fontWeight: 'bold',
        display: 'inline-flex',
        alignItems: 'center',
        justifyContent: 'center',
        minWidth: '20px',
        minHeight: '20px',
        textAlign: 'center',
        lineHeight: '1'
      }}>
        {newRequestWaiter}
      </p></button>
          <button  id="btn-number" style={{ display: "flex", flexDirection: "row" }} onClick={() => functionVisibilityChat()}><p style={{marginLeft: "4px"}}>CHAT</p>     <p style={{
        marginLeft: '5px',
        backgroundColor: 'red',
        color: 'white',
        borderRadius: '50%',
        padding: '2px 8px',
        fontSize: '12px',
        fontWeight: 'bold',
        display: 'inline-flex',
        alignItems: 'center',
        justifyContent: 'center',
        minWidth: '20px',
        minHeight: '20px',
        textAlign: 'center',
        lineHeight: '1'
      }}>
        {newMessageChat}
      </p></button>
          <button disabled={freeVersion} onClick={() => functionVisibilityRegister()}>REGISTRO</button>
        </nav>

        {
          tablesVisibility && <React.Fragment>
            <Tables setConsoleAdmin={setConsoleAdmin} consoleAdmin={consoleAdmin} setNewRequestWaiter={setNewRequestWaiter} newRequestWaiter={newRequestWaiter} tablesArray={tablesArray} setTablesArray={setTablesArray} receiveOrders={receiveOrders} setReceiveOrders={setReceiveOrders} />
          </React.Fragment>
        }

        {
          registerVisibility && <React.Fragment>
            <Register newFetch={newFetch} setNewFetch={setNewFetch} consoleAdmin={consoleAdmin} setConsoleAdmin={setConsoleAdmin} dataOrders={dataOrders} />
          </React.Fragment>
        }

        {
          chatVisibility && <div>
            {chatFunction()}
          </div>
        }

        {
          homeVisibility && <div className="container-mapeo-bd">
            {functionMapeoBaseDeDatos()}
        
            <div style={{display: "flex", flexDirection: "row"}}>
              {visibilityPayOfDay && <h1 className="ganancy-h">GANANCIAS DEL DIA: <span style={{color: "white"}}>{payOfDay}</span></h1>}
              <button id="btn-save" disabled={freeVersion} className='btn-chat-send-2' onClick={deleteAllPedidos} style={{position: "absolute", top: "102%", left: "70%"}}>GUARDAR</button>
        
            </div>
          </div>
        }

      </div>
      {homeVisibility &&
        <div className="admin-carbuy-central-orders">
 {/* {consoleAdmin.length > 0 && functionConsole()} */}
          <h1>Órdenes En Curso</h1>
          {receiveOrders.map((orderData) => {
            const { data } = orderData;
            const { id, table, products, totalPayOrder } = data;
            const isCompleted = completedOrders.has(id);
            const isVisible = orderVisibility[id];
            const hour = new Date()
            const includeForHome = products.some(order => order.forHome === true)
            // const totalProduc = dataShow.products.map((product) => product.name);
            // const productNamesString = totalProduc.join(", ");
          //  console.log("!!!!esta es la estructura de DATA" + JSON.stringify(data))
            return (
              <div key={id} className="container-impresion-orders" >
                <button onClick={() => toggleVisibility(data)} className={`order-item ${isCompleted ? 'active' : ''}`}>
                  Orden mesa: {table}<br /> hora: {products[0].date}{ includeForHome && <div className="container-home-icon"><img src={imgForHome} className="icon-home-admin-screen" /></div>} 
                </button>
                <div className="container-buttons-orders">
                <button onClick={() => imprimirFacturaMixta(id, totalPayOrder, products)}>F</button>
                <button onClick={() => completeOrder(id, table)}>R</button>
                <button onClick={() => deleteOrder(id)}>X</button>
</div>
                {visibilityDetails && functionDataShow()}
              
              </div>
            );
          })}
        </div>
      }


    </div>
  ): <Error setVisibilityClientFrontend={setVisibilityClientFrontend} />);
}



export default Admin