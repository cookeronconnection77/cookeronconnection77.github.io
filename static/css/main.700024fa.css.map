  flex-direction: row;
  align-items: center;
  text-align: center;
  justify-content: center;
}

.App {
  /* background-image: url('./asses/FONDO.jpg'); */
  background-size: cover;
  /* Ajusta la altura del fondo al 100% */
  background-repeat: repeat-x;
  /* El fondo se repite solo horizontalmente */
  background-position: top center;
  /* Posición superior centrada */
  height: 107vh;
  /* Asegura que el fondo cubra toda la altura de la ventana */
  background-attachment: fixed;
  /* Para el efecto parallax en pantallas grandes */
}

