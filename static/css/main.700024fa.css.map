.App {
  text-align: center;
  z-index: 20;
}

body {
  font-family: 'Helvetica Neue', sans-serif;
  background-color: #f4f4f4;
  color: #333;

}


/* */



.App {
  background-image: url('./asses/FONDO.jpg');
  background-size: cover;
  background-repeat: no-repeat;
  background-position: center;
  height: 107vh;
  width: 110vw;
}

h1,
h2,
h3 {
  font-family: 'Helvetica Neue', sans-serif;
  font-weight: bold;
  color: #c8102e;
  ;
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
  /* Sombra suave y ligera */

}

.App p {
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
  /* Sombra suave y ligera */
  text-align: center;
}

/* FRONTEND CLEINTE */

.client-container {
  display: flex;
  flex-direction: row;
}


/* hamburguesas */

.container-hamburguesas {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  /* Crea tres columnas de igual tamaño */
  grid-gap: 5px;
  /* Espaciado entre las celdas de la grilla */
  width: 40vw;
  margin-left: 0;
  margin-top: 100px;
}

.card-food {
  width: 200px;
  /* Ajusta el ancho según tus necesidades */
  margin-bottom: 20px;
  /* Ajusta el espaciado entre las tarjetas */
  border: 1px solid #c8102e;
  padding: 10px;
  /* Ajusta el espacio interno de la tarjeta */
  height: 500px;
}

.img-food {
  width: 150px;
  /* margin-left: calc(50% - 75px); */
  height: 150px;
}




/* CARBUY */

.img-carbuy-logo {
  width: 40%;
  margin-top: -10px;
  /* margin-left: calc(50% - 20%); */
}

.container-carbuy {
  border: 1px solid #ccc;
  padding: 20px;
  margin: 20px 0;
  background-color: rgba(0, 0, 0, 0.5);
  width: 40vw;
  position: absolute;
  top: 0%;
  left: 5%;
  overflow-y: auto;
}

.container-carbuy>div {
  margin-bottom: 10px;
}

.totalPaiContainer {
  margin-top: 20px;
  text-align: right;
  height: auto;
}

.img-carbuy {
  height: 100px;
  margin-left: calc(50% - 60px);
  margin-top: 10px;
  object-fit: cover;
  width: 120px;
}

.name-product {
  list-style-type: none;
  /* Eliminar los puntos de la lista */
  padding: 0;
  /* Eliminar el padding */
  margin: 0;
  /* Eliminar el margen */
  display: flex;
  flex-direction: column;
  /* Organiza los elementos de forma vertical */
  align-items: center;
  /* Centra los ítems de forma horizontal */
  gap: 10px;
  /* Espaciado entre los ítems */
}

h1,
h2,
h3 {
  margin: 5px 0;
  font-weight: normal;
}


button {
  display: inline-block;
  padding: 5px 20px;
  font-size: 16px;
  font-weight: bold;
  text-transform: uppercase;
  border: 1px solid #c8102e;
  border-radius: 5px;
  cursor: pointer;
  font-family: 'Helvetica Neue', sans-serif;
  color: #c8102e;
  ;
  font-weight: bold;
  background-color: black;
  max-height: 80px;
  align-items: center;
}

.icono-btn {
  /* margin-left: calc(50% - 12.5px); */
  margin-top: 0;
  width: 40px;
  height: 20px;
}

/* .buttons-navigate-food-container{
  margin-left: 25px;
} */


.primary-button {
  background-color: #ffcc00;
  /* Amarillo McDonald's */
  color: #d21f17;
  /* Rojo McDonald's */
  box-shadow: 0 0 8px white, 0 0 15px white, 0 0 25px yellowgreen;
  font-size: 20px;
  padding: 2.5px;
  font-family: 'Helvetica Neue', sans-serif;
  border: 1px solid black;
}

.primary-button:disabled {
  background-color: #ccc;
  /* Color de fondo gris claro para indicar que está deshabilitado */
  color: #777;
  /* Texto en gris oscuro o más suave */
  border: 1px solid #999;
  /* Borde más tenue */
  cursor: not-allowed;
  /* Cambia el cursor para indicar que no se puede interactuar */
  opacity: 0.6;
}

#btn-mesero:disabled {
  background-color: #ccc;
  /* Color de fondo gris claro para indicar que está deshabilitado */
  color: #777;
  /* Texto en gris oscuro o más suave */
  border: 1px solid #999;
  /* Borde más tenue */
  cursor: not-allowed;
  /* Cambia el cursor para indicar que no se puede interactuar */
  opacity: 0.6;
}

.btn-chat-send-2:hover {
  background-color: #0097a7;
  transform: scale(1.05);
  box-shadow: 0 0 8px #66e1e1, 0 0 15px #66e1e1, 0 0 25px #66e1e1;
  /* Azul más claro */
}

#btn-mesero {
  align-items: center;
  display: flex;
  flex: 1 1;
  flex-direction: row;
  justify-content: center;
  max-height: 30px;
  text-align: center;
}

/* Estilo para botón secundario */
.secondary-button {
  background-color: #d21f17;
  /* Rojo McDonald's */
  color: #fff;
  /* Blanco */
  box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
  /* Sombreado */
  padding: 2.5px;
  font-family: 'Helvetica Neue', sans-serif;
}

button:hover {
  opacity: 0.9;
  /* Reducir opacidad al pasar el ratón */
  transform: translateY(-1px);
}

