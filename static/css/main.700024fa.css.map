/* form pre send*/

/* Estilos para el contenedor principal */
.container-function-pre-send { /* Fondo oscuro para resaltar el contenido */
  padding: 20px;
  background-color: #00000080;
  border: 1px solid #c8102e;
  border-radius: 10px;
  max-width: 400px; /* Limitar el ancho máximo */
  margin: 0 auto; /* Centrar el contenedor */
  display: flex;
  flex-direction: column;
  align-items: center;
  position: fixed;
  left: 30%;
  top: 30%;
}

.container-title-pre-send h2 {
  color: #fff;
  font-size: 24px;
  margin-bottom: 20px;
  text-align: center;
  margin-top: 30px;
}

.container-number-petitions {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
  gap: 15px;
  
  margin-top: 40px;
}

.container-number-petitions .img-food {
  width: 50px; /* Tamaño de la imagen */
  height: 50px;
  object-fit: cover; /* Asegura que la imagen no se distorsione */
  border-radius: 8px;
}
#numberImput{
  align-items: center;
  padding: 10px;
  width: 70px; /* Ancho fijo */
  font-size: 18px;
  text-align: center; /* Centrar el texto numérico */
  background: #ffffff1a;
  border: 1px solid #ffffff4d;
  border-radius: 10px;
  color: #fff;
  
}

input[type="number"] {
  -webkit-appearance: textfield; /* Para Safari y Chrome */
  -moz-appearance: textfield;    /* Para Firefox */
  appearance: textfield;         /* Para otros navegadores */
}


.container-number-petitions input[type='number'] {
  align-items: center;
  padding: 10px;
  width: 70px; /* Ancho fijo */
  font-size: 18px;
  text-align: center; /* Centrar el texto numérico */
  background: #ffffff1a;
  border: 1px solid #ffffff4d;
  border-radius: 10px;
  color: #fff;

  margin-top: 5px;
  transition: border-color 0.3s ease;
}

.container-number-petitions input[type='number']:focus {
  border-color: #007BFF; /* Cambiar color al enfocarse */
  outline: none;
}

.container-btns-pre-send {
  display: flex;
  justify-content: space-between;
  width: 100%;
  margin-top: 20px;
}
.img-food-presend{
  
    height: 150px;
    width: 150px;

}

.container-btns-pre-send button {
  padding: 10px 20px;
  font-size: 16px;
  background-color: #28a745; /* Botones verdes */
  color: white;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  transition: background-color 0.3s ease;
  width: 45%; /* Espacio igual entre los botones */
}

/* Estilo para el botón de "Domicilio" */

.icon-home-admin-screen{
  width: 40px;
  height: 40px;
  
}
.icon-home-admin{
  width: 20px;
  height: 20px;
  margin-top: 5px;
}
.container-home-icon{
  margin-left: 95%;
  margin-top: -40px;
}
#domicilio {
  background-color: #e74c3c; /* Rojo */
}

#domicilio:hover {
  background-color: #c0392b; /* Rojo oscuro */
  transform: scale(1.05); /* Efecto de agrandamiento al hacer hover */
}

/* Estilo para el botón de "Mesa" */
#mesa {
  background-color: #2ecc71; /* Verde */
}

#mesa:hover {
  background-color: #27ae60; /* Verde más oscuro */
  transform: scale(1.05);
}

.container-btns-pre-send button:hover {
  background-color: #218838; /* Hover para botones */
}

.container-btns-pre-send button:focus {
  outline: none;
}

#numberInput{
  background: #ffffff1a;
  border: 1px solid #ffffff4d;
  border-radius: 10px;
  color: #fff;
}



/* carbuy nueva configuracion */

.container-carbuy-impresion {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 2%; /* Espacio entre productos */
  padding: 2%; /* Relleno interno */
  border-bottom: 1px solid #ccc; /* Línea de separación */
}

.container-impresion-carbuy {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.img-crbuy {
  width: 40px; /* Tamaño de la imagen */
  height: auto; /* Mantener proporción de la imagen */
  object-fit: cover; /* Ajuste de la imagen */
  border-radius: 5px; /* Bordes redondeados */
}

.container-impresion-carbuy h2 {
  margin: 0 2%; /* Espacio horizontal entre la imagen y el texto */
  font-size: 1.5em; /* Tamaño del texto */
  color: #333; /* Color del texto */
  flex-grow: 1; /* Permitir que el texto ocupe espacio disponible */
  text-align: center; /* Alineación central del texto */
}

.btn-reciclaje{
  background-color: transparent;
  border: none;
}

.icono-reciclaje{
  width: 20px;
}
}


